                },
                "service_port": {
                  "type": "number",
                  "description": "Port of the Kubernetes service.",
                  "x-f5xc-field": {
                    "inputType": "spinbutton",
                    "uiLabel": "Service Port",
                    "apiProperty": "origin_servers[].k8s_service.service_port",
                    "advanced": false
                  },
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "service_name",
                "site_locator"
              ]
            },
            {
