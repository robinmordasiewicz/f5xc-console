        }
      }
    },
    "actionSelectors": {
      "submit": "button:has(generic:text(\"Add Data_type\"))",
      "cancel": "button:has(generic:text(\"Cancel\"))",
      "editDataTypeRules": "button:text(\"Add Item\")",
      "applyConfig": "button:has(generic:text(\"Apply\"))",
      "discardConfig": "button:has(generic:text(\"Cancel\"))"
    }
  },
