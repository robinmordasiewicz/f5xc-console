{
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "F5 XC API Definition Configuration",
    "description": "JSON Schema for F5 Distributed Cloud API Definition resource with UI tooltips, defaults, and nested configurations",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "The configuration object will be created with name. It has to be unique within the namespace.\nThe value of name has to follow DNS-1035 format.",
        "x-f5xc-field": {
          "inputType": "textbox",
          "uiLabel": "Name",
          "apiProperty": "name",
          "advanced": false
        },
        "minLength": 1,
        "maxLength": 63,
        "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
        "x-f5xc-pattern-description": "Must start with lowercase letter, contain only lowercase letters, numbers, and hyphens, and end with letter or number"
      },
      "labels": {
        "type": "object",
        "description": "Map of string keys and values that can be used to organize and categorize\n(scope and select) objects as chosen by the user. Values specified here will be used\nby selector expression",
        "x-f5xc-field": {
          "inputType": "object",
          "uiLabel": "Labels",
          "apiProperty": "labels",
          "advanced": false
        },
        "x-f5xc-ui": {
          "placeholder": "Add Label"
        }
      },
      "description": {
        "type": "string",
        "description": "Human readable description for the object",
        "x-f5xc-field": {
          "inputType": "textbox",
          "uiLabel": "Description",
          "apiProperty": "description",
          "advanced": false
        }
      },
      "swagger_specs": {
        "type": "array",
        "description": "List of OpenAPI/Swagger specification files. These files define the API schema and endpoints.",
        "x-f5xc-field": {
          "inputType": "array",
          "uiLabel": "OpenAPI Specification Files",
          "apiProperty": "spec.swagger_specs",
          "advanced": false
        },
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "api_inventory_inclusion_list": {
        "type": "object",
        "description": "Configure API inventory inclusion list for endpoint management",
        "x-f5xc-nested": {
          "trigger": "api_endpoints_management",
          "value": "configured"
        },
        "properties": {
          "api_groups": {
            "type": "array",
            "description": "API Groups field",
            "x-f5xc-field": {
              "inputType": "array",
              "uiLabel": "API Groups",
              "apiProperty": "spec.api_inventory_inclusion_list.api_groups",
              "advanced": false
            },
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "label": "Name",
                  "description": "API group name reference"
                },
                "namespace": {
                  "type": "string",
                  "label": "Namespace",
                  "description": "Namespace of the API group"
                }
              }
            }
          }
        },
        "required": []
      }
    },
    "required": [
      "name"
    ],
    "x-f5xc-metadata": {
