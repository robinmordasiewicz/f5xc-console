{
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "F5 XC Healthcheck Configuration",
    "description": "JSON Schema for F5 Distributed Cloud healthcheck resource with UI tooltips and defaults",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "The configuration object will be created with name. It has to be unique within the namespace. The value of name has to follow DNS-1035 format.",
        "x-f5xc-field": {
          "inputType": "textbox",
          "uiLabel": "Name",
          "apiProperty": "name",
          "advanced": false
        }
      },
      "labels": {
        "type": "object",
        "description": "Map of string keys and values that can be used to organize and categorize (scope and select) objects as chosen by the user. Values specified here will be used by selector expression",
        "x-f5xc-field": {
          "inputType": "textbox",
          "uiLabel": "Labels",
          "apiProperty": "labels",
          "advanced": false
        },
        "x-f5xc-ui": {
          "placeholder": "Add Label"
        }
      },
      "description": {
        "type": "string",
        "description": "Description field",
        "x-f5xc-field": {
          "inputType": "textbox",
          "uiLabel": "Description",
          "apiProperty": "description",
          "advanced": false
        }
      },
      "health_check": {
        "type": "string",
        "description": "Specifies whether to perform HTTP Health Check or TCP Health check",
        "x-f5xc-field": {
          "inputType": "textbox",
          "uiLabel": "Health Check",
          "apiProperty": "health_check",
          "advanced": false
        },
        "default": "HTTP HealthCheck",
        "x-f5xc-ui": {
          "defaultValue": "HTTP HealthCheck"
        },
        "enum": [
          "HTTP HealthCheck",
          "TCP HealthCheck"
        ]
      },
      "timeout": {
        "type": "number",
        "description": "Timeout in seconds to wait for successful response. In other words, it is the time to wait for a health check response. If the timeout is reached the health check attempt will be considered a failure.",
        "x-f5xc-field": {
          "inputType": "spinbutton",
          "uiLabel": "Timeout",
          "apiProperty": "timeout",
          "advanced": false
        },
        "default": 3,
        "x-f5xc-ui": {
          "defaultValue": "3",
          "unit": "seconds"
        }
      },
      "interval": {
        "type": "number",
        "description": "Time interval in seconds between two healthcheck requests.",
        "x-f5xc-field": {
          "inputType": "spinbutton",
          "uiLabel": "Interval",
          "apiProperty": "interval",
          "advanced": false
        },
        "default": 15,
        "x-f5xc-ui": {
          "defaultValue": "15",
          "unit": "seconds"
        }
      },
      "unhealthy_threshold": {
        "type": "number",
        "description": "Number of failed responses before declaring unhealthy. In other words, this is the number of unhealthy health checks required before a host is marked unhealthy. Note that for http health checking if a host responds with 503 this threshold is ignored and the host is considered unhealthy immediately.",
        "x-f5xc-field": {
          "inputType": "spinbutton",
          "uiLabel": "Unhealthy Threshold",
          "apiProperty": "unhealthy_threshold",
          "advanced": false
        },
        "default": 1,
        "x-f5xc-ui": {
          "defaultValue": "1"
        }
      },
      "healthy_threshold": {
        "type": "number",
        "description": "Number of successful responses before declaring healthy. In other words, this is the number of healthy health checks required before a host is marked healthy. Note that during startup, only a single successful health check is required to mark a host healthy.",
        "x-f5xc-field": {
          "inputType": "spinbutton",
          "uiLabel": "Healthy Threshold",
          "apiProperty": "healthy_threshold",
          "advanced": false
        },
        "default": 3,
        "x-f5xc-ui": {
          "defaultValue": "3"
        }
      },
      "jitter_percent": {
        "type": "number",
        "description": "Add a random amount of time as a percent value to the interval between successive healthcheck requests.",
        "x-f5xc-field": {
          "inputType": "spinbutton",
          "uiLabel": "Jitter Percent",
          "apiProperty": "jitter_percent",
          "advanced": true
        },
        "default": 30,
        "x-f5xc-ui": {
          "defaultValue": "30",
          "unit": "percent"
        }
      }
    },
    "required": [
      "name",
      "health_check",
      "timeout",
      "interval",
      "unhealthy_threshold",
      "healthy_threshold"
    ],
