    "nestedSelectors": {
      "risk_based_blocking_config": {
        "High Risk": {
          "schemaPath": "properties.risk_based_blocking_config.properties.high_risk_action",
          "inputType": "textbox",
          "required": true,
          "advanced": false
        },
        "Medium Risk": {
