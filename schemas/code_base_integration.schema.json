              "inputType": "textbox",
              "uiLabel": "Secret Type",
              "apiProperty": "secret_type",
              "advanced": false
            },
            "default": "Blindfolded Secret",
            "x-f5xc-ui": {
              "defaultValue": "Blindfolded Secret"
            },
            "enum": [
              "Blindfolded Secret",
              "Clear Secret"
            ],
            "x-f5xc-enum-descriptions": {
              "Blindfolded Secret": "Secret encrypted using F5 XC Blindfold technology",
              "Clear Secret": "Secret that is not encrypted (stored in plain text)"
            },
            "minLength": 1
          },
          "action": {
            "type": "string",
            "description": "Action field",
            "x-f5xc-field": {
              "inputType": "textbox",
              "uiLabel": "Action",
              "apiProperty": "action",
              "advanced": false
