          "trigger": "github_personal_access_token",
          "value": "configured"
        },
        "properties": {
          "secret_type": {
            "type": "string",
            "description": "Choose how to store the secret: Blindfolded Secret encrypts using F5 XC technology, Clear Secret stores as plain text.",
