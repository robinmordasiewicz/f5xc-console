{
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "F5 XC Code Base Integration Configuration",
    "description": "JSON Schema for F5 Distributed Cloud Code Base Integration resource with UI tooltips, defaults, and nested configurations",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "The configuration object will be created with name. It has to be unique within the namespace.\nThe value of name has to follow DNS-1035 format.",
        "x-f5xc-field": {
          "inputType": "textbox",
          "uiLabel": "Name",
          "apiProperty": "name",
          "advanced": false
        },
        "minLength": 1,
        "maxLength": 63,
        "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
        "x-f5xc-pattern-description": "Must start with lowercase letter, contain only lowercase letters, numbers, and hyphens, and end with letter or number"
      },
      "labels": {
        "type": "object",
        "description": "Map of string keys and values that can be used to organize and categorize\n(scope and select) objects as chosen by the user. Values specified here will be used\nby selector expression",
        "x-f5xc-field": {
          "inputType": "object",
          "uiLabel": "Labels",
          "apiProperty": "labels",
          "advanced": false
        },
        "x-f5xc-ui": {
          "placeholder": "Add Label"
        }
      },
      "description": {
        "type": "string",
        "description": "Human readable description for the object",
        "x-f5xc-field": {
          "inputType": "textbox",
          "uiLabel": "Description",
          "apiProperty": "description",
          "advanced": false
        }
      },
      "code_base": {
        "type": "string",
        "description": "Select the type of code repository integration. Each type has specific fields for authentication and connection settings.",
        "x-f5xc-field": {
          "inputType": "textbox",
          "uiLabel": "Code Base",
          "apiProperty": "spec.code_base_type",
          "advanced": false
        },
        "default": "GitHub Integration",
        "x-f5xc-ui": {
          "defaultValue": "GitHub Integration"
        },
        "enum": [
          "GitHub Integration",
          "GitHub Enterprise Integration",
          "GitLab Cloud Integration",
          "GitLab Enterprise Integration",
          "BitBucket Cloud Integration",
          "BitBucket Server Integration",
          "Azure Repos Integration"
        ],
        "x-f5xc-enum-descriptions": {
          "GitHub Integration": "Connect to GitHub.com repositories",
          "GitHub Enterprise Integration": "Connect to GitHub Enterprise Server on-premises",
          "GitLab Cloud Integration": "Connect to GitLab.com repositories",
          "GitLab Enterprise Integration": "Connect to self-hosted GitLab Enterprise",
          "BitBucket Cloud Integration": "Connect to Atlassian BitBucket Cloud repositories",
          "BitBucket Server Integration": "Connect to self-hosted BitBucket Server (formerly Stash)",
          "Azure Repos Integration": "Connect to Azure DevOps Repos (formerly VSTS)"
        },
        "minLength": 1
      },
      "github_username": {
        "type": "string",
        "description": "GitHub account username used for API authentication. Requires a Personal Access Token with appropriate repository permissions.",
        "x-f5xc-field": {
          "inputType": "textbox",
          "uiLabel": "GitHub Username",
          "apiProperty": "spec.github.username",
          "advanced": false
        },
        "x-f5xc-conditional": {
          "field": "code_base",
          "value": "GitHub Integration"
        },
        "minLength": 1
      },
      "github_verify_ssl": {
        "type": "boolean",
        "description": "Enable SSL certificate verification when connecting to GitHub API. Disable only for testing with self-signed certificates.",
        "x-f5xc-field": {
          "inputType": "checkbox",
          "uiLabel": "GitHub Verify SSL",
          "apiProperty": "spec.github.verify_ssl",
          "advanced": false
        },
        "default": true,
        "x-f5xc-ui": {
          "defaultValue": "true"
        },
        "x-f5xc-conditional": {
          "field": "code_base",
          "value": "GitHub Integration"
        }
      },
      "github_enterprise_hostname": {
