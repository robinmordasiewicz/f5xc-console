              "defaultValue": "Built-in"
            },
            "enum": [
              "Built-in"
            ],
            "x-f5xc-conditional": {
              "field": "secret_type",
              "value": "Blindfolded Secret"
            }
          },
          "secret_to_blindfold": {
            "type": "string",
            "description": "Enter the secret value (e.g., Personal Access Token) to be encrypted using F5 XC Blindfold technology.",
            "x-f5xc-field": {
              "inputType": "textbox",
              "uiLabel": "Secret to Blindfold",
