              "defaultValue": "Blindfold New Secret"
            },
            "enum": [
              "Blindfold New Secret"
            ],
            "x-f5xc-conditional": {
              "field": "secret_type",
              "value": "Blindfolded Secret"
            },
            "minLength": 1
          },
          "policy_type": {
            "type": "string",
            "description": "Policy Type field",
            "x-f5xc-field": {
              "inputType": "textbox",
              "uiLabel": "Policy Type",
              "apiProperty": "policy_type",
